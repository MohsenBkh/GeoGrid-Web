# Runs geogrid-cleanup.service every 6 hours.
# Install: sudo cp deploy/geogrid-cleanup.* /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now geogrid-cleanup.timer
[Unit]
Description=Run GeoGrid Web cleanup every 6 hours

[Timer]
OnBootSec=10min
OnUnitActiveSec=6h

[Install]
WantedBy=timers.target
