# Copy to .env for local development (loaded automatically by app/settings.py).
# On Render this file is NOT used -- set the same names under
# Dashboard -> your service -> Environment instead.

# --- ZarinPal -------------------------------------------------------------
# Placeholder value: the sandbox will reject it, so register a free sandbox
# merchant at https://sandbox.zarinpal.com and paste its merchant id here to
# test the full payment flow with fake money.
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# true  -> https://sandbox.zarinpal.com (no real money)
# false -> https://payment.zarinpal.com (REAL money; needs a verified merchant)
ZARINPAL_SANDBOX=true

# --- Pricing (Rials, not Toman: 500000 Rials = 50000 Toman) ---------------
GEOGRID_PRICE_RIALS=500000

# --- Site ----------------------------------------------------------------
# Public URL of the site; used to build the ZarinPal callback URL.
# Leave empty locally (defaults to http://localhost:8000).
# On a VPS behind nginx: https://yourdomain.com
# On Render: leave empty, RENDER_EXTERNAL_URL is used automatically.
SITE_BASE_URL=

# --- Limits ---------------------------------------------------------------
GEOGRID_MAX_UPLOAD_MB=100
GEOGRID_JOB_RETENTION_HOURS=48
# In-app cleaner interval in hours (0 = disable, e.g. when a systemd timer
# or cron job already runs `python -m app.cleanup`).
GEOGRID_CLEANUP_INTERVAL_HOURS=6
